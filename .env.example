# Vite client (safe to set in Cloudflare Pages env vars)
VITE_APP_CDN_URL=https://cdn.weweb.io/
VITE_APP_API_URL=https://api.weweb.io/v1
VITE_APP_PLUGINS_URL=https://data.weweb.io
VITE_APP_PREVIEW_URL=weweb.io

# Cloudflare Pages build
NODE_VERSION=24

# Cloudflare Pages Functions (Dashboard only — never commit real secrets)
AIRTABLE_TOKEN=pat...
SESSION_TTL_DAYS=7
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key
MAKE_CHECKOUT_WEBHOOK_URL=https://hook.eu1.make.com/your-checkout-hook
TAMAR_API_KEY=your-tamar-api-key